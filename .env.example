# =============================================================================
# AJRASAKHA - Unified Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env files with real secrets to git.
# =============================================================================

# =============================================================================
# SERVER (Node.js/Express)
# =============================================================================
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars_long
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# =============================================================================
# FRONTEND (Vite/React)
# =============================================================================
VITE_API_URL=http://localhost:5000
VITE_AUTH_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# =============================================================================
# PRIDICTION-ENGINE (Python/FastAPI)
# =============================================================================
PREDICTION_ENGINE_PORT=8000

# =============================================================================
# SCRAPER-ENGINE / ENDPOINT-DISCOVERY (Python)
# =============================================================================
# MongoDB (shared with server)
DB_NAME=mandi_insights

# LLM Provider: "google" | "openai" | "openrouter"
LLM_PROVIDER=openrouter
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key_optional
OPENROUTER_API_KEY=your_openrouter_api_key
# Comma-separated list of models for failover
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free,google/gemini-2.0-flash-001

# Agent Config
# Input mode: "mongo" | "csv"
INPUT_MODE=mongo
# Logging mode: "mongo" | "txt"
LOG_MODE=mongo
# Agent mode: "scrape" | "discover" | "discover_and_scrape" | "single_url"
AGENT_MODE=discover_and_scrape

# Playwright
HEADLESS=true

# Thresholds
MAX_PAGES_PER_SOURCE=50
DISCOVERY_TIMEOUT_SECONDS=120
REQUEST_DELAY_MS=500
