# =============================================================================
# AJRASAKHA - Unified Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env files with real secrets to git.
# =============================================================================

# =============================================================================
# SERVER (Node.js/Express)
# =============================================================================
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars_long
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# =============================================================================
# FRONTEND (Vite/React)
# =============================================================================
VITE_API_URL=http://localhost:5000/api/consumer-portal
VITE_AUTH_BASE_URL=http://localhost:5000/api/consumer-portal/auth
VITE_API_BASE_URL=http://localhost:5000/api/consumer-portal

# Firebase Client SDK (get from Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:xxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Get VAPID key from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# =============================================================================
# PRIDICTION-ENGINE (Python/FastAPI)
# =============================================================================
PREDICTION_ENGINE_PORT=8000

# =============================================================================
# SCRAPER-ENGINE / ENDPOINT-DISCOVERY (Python)
# =============================================================================
# MongoDB (shared with server)
DB_NAME=mandi_insights

# LLM Provider: "google" | "openai" | "openrouter"
LLM_PROVIDER=openrouter
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key_optional
OPENROUTER_API_KEY=your_openrouter_api_key
# Comma-separated list of models for failover
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free,google/gemini-2.0-flash-001

# Agent Config
# Input mode: "mongo" | "csv"
INPUT_MODE=mongo
# Logging mode: "mongo" | "txt"
LOG_MODE=mongo
# Agent mode: "scrape" | "discover" | "discover_and_scrape" | "single_url"
AGENT_MODE=discover_and_scrape

# Playwright
HEADLESS=true

# Thresholds
MAX_PAGES_PER_SOURCE=50
DISCOVERY_TIMEOUT_SECONDS=120
REQUEST_DELAY_MS=500

# =============================================================================
# FIREBASE (Push Notifications)
# =============================================================================
# To enable push notifications, get your Firebase service account:
# 1. Go to https://console.firebase.google.com/ → Project Settings → Service Accounts
# 2. Click "Generate new private key" and download the JSON
# 3. Use either Option 1 (full JSON) or Option 2 (individual fields)

# Option 1: Full service account JSON (paste the entire JSON content as one line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"...","client_email":"..."}

# Option 2: Individual credentials (extract from the JSON file)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
