# Firebase Admin SDK (required for push notifications)
# Option 1: Full JSON
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option 2: Individual fields
FIREBASE_PROJECT_ID=mandi-insights
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@mandi-insights.iam.gserviceaccount.com

# Other existing variables
MONGODB_URI=mongodb://localhost:27017/mandi_insights
JWT_SECRET=your-jwt-secret
PORT=5000
